# EdumentX environment template
#
# Copy this file to `.env` and fill in the values. The `.env` file is
# git-ignored. See `Documentation/01-Architecture/ARCHITECTURE.md` for
# how each key is used.
#
# Client values only. The existing backend uses Blaze within free quotas;
# creating/deploying your own backend is separate from installing the app.

# ---- Firebase ----
# Native Auth/Firestore initialize from Android google-services.json.
# The public values below are also used by selected developer tools.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional public WEB OAuth client ID for your Firebase project.
# Use the Web application client, not an Android client. When blank, the
# app retains the original minor project's public development client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---- Supabase (Object Storage only — 1 GB free, no card) ----
# Created at https://supabase.com → free tier, region "South Asia
# (Mumbai)" to match the Firebase database location. Two buckets:
#   - public-avatars           (read-by-all, image/* MIME only, 5 MB cap)
#   - private-verification-docs (read-by-owner + admin, locked-down RLS)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# ---- Map (native expo-maps) ----
# Google Maps on Android via native expo-maps; Apple Maps on iOS.
# Restricted key recommended (Maps SDK for Android only).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Build metadata ----
EXPO_PUBLIC_APP_ENV=development
# Sandbox payment screens remain off unless explicitly enabled in development.
EXPO_PUBLIC_ENABLE_SANDBOX_PAYMENTS=false

# ── LLM keys: NEVER prefix these with EXPO_PUBLIC_ ──
# Aug 24 audit: EXPO_PUBLIC_* vars are bundled into the shipped JS and
# extractable from any binary. The Groq key lives ONLY in Supabase
# Edge Function secrets (the `groq-proxy` function holds it); the HF
# token is only used by LOCAL seeding scripts (plain HF_API_TOKEN).
# Groq (client re-rank path) → Supabase secrets: GROQ_API_KEY
# If running a privileged seed/admin tool, supply its credentials in that
# tool's private environment, not in this mobile client template.

# ---- Mock data layer (development only) ----
# When true, the app reads from `lib/mock/tutors.ts` instead of
# Firestore, and the AI chatbot runs a client-side mock pipeline
# instead of calling the Supabase Edge Function. Useful for testing
# the conversation logic + filter pipeline offline without seeding
# Firebase or Supabase. Switch back to live by setting to false
# (or removing the line) and restarting the Expo dev client.
EXPO_PUBLIC_USE_MOCK_DATA=true
