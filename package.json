{
  "name": "edumentx",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:all": "firebase deploy --only firestore,storage",
    "seed:admin:build": "npx tsc scripts/seedAdmin.ts --esModuleInterop --module commonjs --target ES2020 --skipLibCheck --outDir dist/scripts",
    "seed:admin": "npm run seed:admin:build && node dist/scripts/seedAdmin.js",
    "seed:admin:list": "npm run seed:admin:build && node dist/scripts/seedAdmin.js -- --list",
    "seed:tutors:build": "npx tsc scripts/seedSupabaseTutors.ts --esModuleInterop --module commonjs --target ES2020 --skipLibCheck --outDir dist/scripts",
    "seed:tutors": "npm run seed:tutors:build && node dist/scripts/seedSupabaseTutors.js",
    "delete:user:build": "npx tsc scripts/deleteUser.ts --esModuleInterop --module commonjs --target ES2020 --skipLibCheck --outDir dist/scripts",
    "delete:user": "npm run delete:user:build && node dist/scripts/deleteUser.js",
    "smoke:enrollments:build": "npx tsc scripts/smokeTestEnrollments.ts --esModuleInterop --module commonjs --target ES2020 --skipLibCheck --outDir dist/scripts",
    "smoke:enrollments": "npm run smoke:enrollments:build && node dist/scripts/smokeTestEnrollments.js",
    "test:derived:build": "npx tsc scripts/testDerived.ts --esModuleInterop --module commonjs --target ES2020 --skipLibCheck --outDir dist/scripts",
    "test:derived": "npm run test:derived:build && node --test dist/scripts/scripts/testDerived.js",
    "backfill:tutor-availability:build": "npx tsc scripts/backfillTutorAvailability.ts --esModuleInterop --module commonjs --target ES2020 --skipLibCheck --outDir dist/scripts",
    "backfill:tutor-availability": "npm run backfill:tutor-availability:build && node dist/scripts/backfillTutorAvailability.js",
    "test:rules:deployed": "node scripts/checkDeployedRules.mjs",
    "test:rules": "npm run test:rules:deployed && firebase emulators:exec --only firestore --project demo-edumentx \"node scripts/rulesEmulationTest.mjs\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/auth": "^24.1.1",
    "@react-native-firebase/firestore": "^24.1.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@supabase/supabase-js": "^2.108.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.35",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-maps": "~0.12.10",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "firebase-admin": "^14.1.0",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "supercluster": "^8.0.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/supercluster": "^7.1.3",
    "babel-preset-expo": "^54.0.11",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-css-interop": "0.2.5"
  },
  "private": true
}
