# ─── Dev Mode ────────────────────────────────────────────────────────────────
# Each developer sets their own .env file (gitignored) so they can work on
# any screen without being redirected by the auth flow.
#
# Options:
#   auth     — start at the auth intro flow and stay within auth screens
#   tenant   — auto-login as tenant and go to /(tenant)/(tabs)
#   landlord — auto-login as landlord and go to /(landlord)/(tabs)
#
# Unset or delete this var for production behavior (real auth redirects).
# After changing this value, restart Metro (for example: npm start -- --clear).
EXPO_PUBLIC_DEV_MODE=auth

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
# NEVER commit the actual values. Add them to your local .env file (gitignored).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
