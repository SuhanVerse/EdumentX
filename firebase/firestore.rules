rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── Admin identity ────────────────────────────────────────────────
    // Admin status lives in a Firebase Auth CUSTOM CLAIM (`admin:
    // true`), set exclusively by `scripts/seedAdmin.ts` via the Admin
    // SDK alongside the auditable `admins/{uid}` ledger doc. Clients
    // cannot mint claims; there is no self-promotion path.
    //
    // SECURITY FIX (Aug 24 audit): an earlier revision trusted
    // `users/{uid}.data.role == "admin"` here. Because the owner can
    // write their own root user doc, that clause let ANY signed-in
    // user promote themselves to full admin by patching their own
    // `role` field — unlocking every student's PII (incl. precise
    // location), self-approval of tutor verification, `tutors/*`
    // writes and user deletion. The `users.role` clause is REMOVED.
    // The client still reads `users/{uid}.role` for dashboard
    // ROUTING (cosmetic), but rules no longer trust it for AUTHORITY.
    //
    // WHY A CLAIM (not `exists(admins/{uid})`): (1) zero Firestore
    // reads per evaluation — the old form cost a document read on
    // EVERY guarded request; (2) the local Firestore emulator
    // (v1.22.0) THROWS on exists() targeting an absent doc, which
    // poisoned whole rule blocks during test runs; claims evaluate to
    // a plain boolean everywhere. Legacy admins must re-run
    // `npm run seed:admin` once to receive the claim.
    function isAdmin() {
      // .get(key, default) — plain indexing throws when the claim is
      // absent (every regular user's token), and a throwing clause
      // poisons its whole statement in the rules engine.
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // The single source of truth for which notification `type` values
    // a client is allowed to write. Used by BOTH the parent
    // `notifications/{uid}` create rule and the nested
    // `notifications/{uid}/items/{itemId}` create rule — keeping the
    // enum in one function means the two lists can never drift.
    function isValidNotificationType(type) {
      return type in [
        "verification_approved",
        "verification_rejected",
        "verification_more_info",
        "edit_approved",
        "edit_rejected",
        "enrollment_accepted",
        "enrollment_declined",
        "enrollment_removed",
        "enrollment_completed"
      ];
    }

    // ── Field-immutability primitive ──────────────────────────────────
    // True when key `k` is UNCHANGED by the write: present before and
    // after with an equal value, or absent from both views. Pins
    // server-managed / sensitive fields without diff(), which the local
    // Firestore emulator (v1.22.0) evaluates as no-change for some patch
    // shapes, and without one-sided 'k' in request.resource.data checks,
    // which misfire because the masked-update view MERGES existing doc
    // fields into request.resource.data. Dynamic indexing (data[k]) is
    // guarded by short-circuited `in` checks so absent keys never error.
    function unchanged(k) {
      return (
        (
          !(k in resource.data)
          && !(k in request.resource.data)
        )
        || (
          (k in resource.data)
          && (k in request.resource.data)
          && request.resource.data[k] == resource.data[k]
        )
      );
    }

    // The root user doc — created by `RoleSelection` and read by
    // `app/_layout.tsx` to decide which dashboard to show.
    //
    // Admin write grants (Phase "user lifecycle", Aug 2026):
    //   - `update` — lets an admin soft-delete a user (marking
    //     `status: "deleted" + deletedAt`) without an Admin SDK.
    //   - `delete` — lets an admin permanently remove the doc once
    //     the account's data has been purged by `lib/admin/
    //     userLifecycle.ts`. The matching Firebase Auth identity
    //     cannot be deleted from the client (Auth.delete() is
    //     current-user only) — that step runs on a dev laptop via
    //     `scripts/deleteUser.ts` (see ARCHITECTURE.md §11).
    match /users/{userId} {
      // ── SECURITY FIX (Aug 24 audit): owner-write allowlist ──────────
      // The owner update previously allowed ANY field, which (before
      // the isAdmin() fix above) enabled self-promotion to admin and
      // still allowed a suspended user to un-suspend themselves by
      // flipping `status`. The allowlist below covers exactly the
      // fields the client legitimately writes:
      //   RoleSelection        → uid,email,displayName,username,
      //                          createdAt,updatedAt
      //   Student/TutorProfile → uid,email,role,updatedAt
      //   pushService          → uid,pushTokens
      //   _layout heal write   → uid,role,email,updatedAt
      //   EditTeachingDetails  → updatedAt
      // Deliberately EXCLUDED: `status` / `deletedAt` (admin-only
      // suspension via UserManagement), `role:"admin"` (authority
      // lives in admins/{uid}), subscription fields (server-granted
      // only — see tutors/{uid} note), and any future privileged key
      // must be added here consciously.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'username',
          'photoUrl', 'createdAt', 'updatedAt', 'role', 'pushTokens'
        ])
        // Guarded presence check — reading an absent key on
        // request.resource.data errors (and denies) in rules.
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == userId)
        && (!('role' in request.resource.data)
            || request.resource.data.role in ['student', 'tutor']);
      allow read: if isOwner(userId) || isAdmin();
      // Owner update = presence-FORBID model: the owner may touch any
      // field EXCEPT the ones enumerated below. Chosen over a
      // keys()/diff() allowlist because those operators proved
      // transport-dependent in the local emulator (v1.22.0 evaluates
      // diff() as no-change for some patch shapes); simple key-
      // presence checks and scalar/list/map equality behave
      // identically everywhere.
      //
      // Forbidden for the owner (each with its reason):
      //   status/deletedAt        — suspension is admin-only
      //   subscriptionTier/
      //   subscriptionExpiresAt   — server-granted only (eSewa edge fn)
      // Role gets its own transition guard below (student/tutor only).
      allow update: if (
        isOwner(userId)
        // uid is immutable IF the patch touches it at all — but
        // uid-less maintenance patches (e.g. EditTeachingDetails'
        // `updatedAt` touch) must stay legal, and reading an absent
        // key on request.resource.data ERRORS in rules.
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == userId)
        && unchanged("status")
        && unchanged("deletedAt")
        && unchanged("subscriptionTier")
        && unchanged("subscriptionExpiresAt")
        // Role-transition guard: an existing role value may only be
        // kept as-is or changed to student/tutor. Each arm guards
        // against absent-key evaluation errors: the patch may omit
        // `role` entirely, and docs created before any role existed
        // have no `resource.data.role`.
        && (!('role' in request.resource.data)
            || !('role' in resource.data)
            || request.resource.data.role == resource.data.role
            || request.resource.data.role in ['student', 'tutor'])
      ) || isAdmin();
      allow delete: if isAdmin();

      // Profile subcollection docs (one per role). The screens write
      // these from `StudentProfileScreen` / `TutorProfileScreen` and
      // the dashboards read them on every render. The owner can write
      // any field — the form-level validation is the source of truth
      // for shape, and the security rules just enforce "you can only
      // touch your own profile."
      //
      // Admins get read+write access too so the admin queue can
      // mirror verification status flags (verificationStatus,
      // isVerifiedProfessional, hasPendingUpdate, rejectionReason)
      // onto the profile doc atomically with the source-of-truth
      // tutorVerifications/{uid}.status change. The admin can NOT
      // edit the personal fields (fullName, headline, bio, etc.)
      // because they don't carry those keys in the batch update.
      //
      // Student-facing `tutorProfile/default` is readable by ALL
      // signed-in users so the TutorDetailsScreen can render the
      // full profile (including documents for the demo video).
      // The more-specific rule below overrides the wildcard for
      // this specific subcollection path.
      // Precise student location (the `location` field, incl.
      // `location.coordinates`) is PII — readable only by the
      // student, an admin, or a TUTOR WITH AN ACTIVE ENROLLMENT
      // (proven by the `locationAccess` marker under this same user
      // doc). Non-enrolled tutors get permission-denied, and the
      // tutor-facing UI renders "Location hidden until enrolled" for
      // that read. The marker is written in the SAME transaction as
      // the roster row by `acceptRequest` and deleted on
      // `removeEnrollment` / `sweepExpiredEnrollments`, so "can read
      // the location" ⟺ "actively enrolled right now".
      match /studentProfile/default {
        allow read: if isOwner(userId) || isAdmin()
          || exists(/databases/$(database)/documents/users/$(userId)/locationAccess/$(request.auth.uid));
      }

      // Per-(student, tutor) marker proving an ACTIVE enrollment
      // exists, so the student's precise location can be shared with
      // exactly that tutor. The tutor writes their own marker inside
      // the `acceptRequest` transaction; the rule re-verifies the
      // referenced roster row is real, points at this student, and is
      // active — a forged marker for an arbitrary student is
      // rejected because no such roster row exists.
      match /locationAccess/{tutorUid} {
        allow read: if isOwner(userId) || isAdmin()
          || request.auth.uid == tutorUid;
        allow create, update: if request.auth.uid == tutorUid
          && request.resource.data.studentUid == userId
          && request.resource.data.status == "active"
          && request.resource.data.enrollmentId is string
          && existsAfter(/databases/$(database)/documents/enrollments/$(tutorUid)/roster/$(request.resource.data.enrollmentId))
          && getAfter(/databases/$(database)/documents/enrollments/$(tutorUid)/roster/$(request.resource.data.enrollmentId)).data.studentUid == userId
          && getAfter(/databases/$(database)/documents/enrollments/$(tutorUid)/roster/$(request.resource.data.enrollmentId)).data.status == "active";
        allow delete: if isOwner(userId) || isAdmin()
          || request.auth.uid == tutorUid;
      }

      match /tutorProfile/default {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId) || isAdmin();
        // ── SECURITY FIX (Aug 24 audit): Pro tier is server-granted ──
        // `subscriptionTier` / `subscriptionExpiresAt` are the
        // monetization gate (the roster-create rule reads them to set
        // the capacity cap). They are written ONLY by the
        // `create-esewa-order` edge function after a verified eSewa
        // payment (service-role REST write bypasses rules entirely).
        //
        // Writer model (presence/equality constructs only — see the
        // users/{userId} note on why not diff()/keys()):
        //   owner   — anything EXCEPT the two tier keys
        //   reviewer— the authoring student (submitReview) may bump
        //             ONLY the five rating aggregates + updatedAt;
        //             every personal field is pinned to its current
        //             value via unchanged-or-absent equality guards.
        allow update: if isAdmin()
          || (isOwner(userId)
            && unchanged("subscriptionTier")
            && unchanged("subscriptionExpiresAt"))
          || (isSignedIn()
            && unchanged("subscriptionTier")
            && unchanged("subscriptionExpiresAt")
            && unchanged("fullName")
            && unchanged("headline")
            && unchanged("bio")
            && unchanged("photoUrl")
            && unchanged("email")
            && unchanged("monthlyRateNpr")
            && unchanged("institution")
            && unchanged("degree")
            && unchanged("subjects")
            && unchanged("gradesTeaching")
            && unchanged("documents")
            && unchanged("location")
            && unchanged("availability")
            && unchanged("studentCapacity")
            && unchanged("enrolledCount")
            && unchanged("verificationStatus")
            && unchanged("hasPendingUpdate"));
      }

      match /{subcollection}/{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        // ── SECURITY FIX (Aug 24 audit): this wildcard previously
        // granted the owner full RW on EVERY subdoc, which silently
        // re-opened the `tutorProfile/default` subscription keys
        // closed by the specific rule above (an OR-across-matches
        // hole caught live by the emulator suite).
        //
        // ── PROD FIX (Aug 25, live device repro) ────────────────────
        // The tier pins MUST NOT be evaluated on CREATE: in production
        // (unlike the emulator, which treats it as {}) reading
        // `resource.data` while the doc does not exist THROWS — the
        // thrown statement denies every FIRST-TIME subdoc save
        // (StudentProfileScreen's studentProfile/default write was
        // 403-ing on real devices). Verbs are therefore split:
        //   create → tier keys may not exist at birth (no
        //            resource.data access anywhere)
        //   update → doc exists → unchanged() parity is safe
        //   delete → owner/admin purge (as before the split)
        allow create: if isAdmin()
          || (isOwner(userId)
            && !('subscriptionTier' in request.resource.data)
            && !('subscriptionExpiresAt' in request.resource.data));
        allow update: if isAdmin()
          || (isOwner(userId)
            && unchanged("subscriptionTier")
            && unchanged("subscriptionExpiresAt"));
        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    // Denormalized tutor directory — the student-facing discovery
    // surface (StudentHome, MapSearch) reads this collection via
    // `lib/verification/discovery.ts`. Each doc mirrors the
    // corresponding `users/{uid}/tutorProfile/default` subcollection
    // doc and is written atomically when the admin approves a tutor
    // (see `applyVerificationDecision`).
    //
    // Read is public (no auth required) so the home screen and detail
    // page always work even if the Firebase Auth token hasn't fully
    // propagated to the Firestore SDK. This is safe because:
    //   1. The data in this collection is intentionally public-facing
    //      (name, subjects, rate, location — no PII)
    //   2. Only the admin queue writes to this collection
    //   3. The richer user profile subcollection (`users/{uid}/tutorProfile/default`)
    //      remains protected by `isSignedIn()`
    match /tutors/{tutorId} {
      allow read: if true;
      // ── Owner visibility-flag carve-out + admin mirror ────────────
      // SINGLE update statement, OWNER BRANCH FIRST: a signed-in
      // owner short-circuits past isAdmin(), mirroring the
      // users/{userId} update shape. This matters beyond style — the
      // local Firestore emulator (v1.22.0) THROWS on exists() targeting
      // an absent admins doc, and a throwing sibling statement poisons
      // co-block statements; the short-circuit keeps the hot owner
      // path provable locally while prod semantics are identical.
      //
      // ── SECURITY FIX (Aug 24 audit): Pro mirror is server-granted ──
      // The previous allowlist also let the owner self-write
      // `subscriptionTier` / `subscriptionExpiresAt` — a free tutor
      // could mint Pro (and its capacity cap raise) with one PATCH.
      // The owner may change ONLY the availability flag (+ updatedAt
      // sibling); every other mirror field owned by the approval
      // write or the Pro edge function is PINNED via unchanged().
      allow update: if (
        isOwner(tutorId)
        && unchanged("uid")
        && unchanged("fullName")
        && unchanged("username")
        && unchanged("headline")
        && unchanged("bio")
        && unchanged("photoUrl")
        && unchanged("email")
        && unchanged("subjects")
        && unchanged("gradesTeaching")
        && unchanged("monthlyRateNpr")
        && unchanged("location")
        && unchanged("yearsExperience")
        && unchanged("gender")
        && unchanged("tutoringMode")
        && unchanged("languages")
        && unchanged("degree")
        && unchanged("institution")
        && unchanged("responseRate")
        && unchanged("rating")
        && unchanged("reviewCount")
        && unchanged("verificationStatus")
        && unchanged("isVerifiedProfessional")
        && unchanged("hasPendingUpdate")
        && unchanged("subscriptionTier")
        && unchanged("subscriptionExpiresAt")
          // Flag: whenever it exists in the post-write view (merged) its
          // type stays boolean — the owner may flip it, never retype it
          // (removal counts as a change and is denied by unchanged()).
          && (
            !('isAvailableForNewStudents' in request.resource.data)
            || request.resource.data.isAvailableForNewStudents is bool
          )
          // Aug 25: hasAvailability mirrors "at least one weekly slot
          // enabled" so student discovery can hide slot-less tutors.
          // Owner-writable (capacity-save flips it); boolean-only.
          && (
            !('hasAvailability' in request.resource.data)
            || request.resource.data.hasAvailability is bool
          )
        || isAdmin()
      );
      allow create: if isAdmin();
      // Admin can purge the discovery copy when the user is deleted.
      allow delete: if isAdmin();
    }

    // Admins collection — bootstrap is locked to the Firebase Admin SDK
    // (see scripts/seedAdmin.ts) or the Firebase Console. Clients can
    // *read their own* admin doc so the auth guard can detect admin
    // status on sign-in. Writes are server-only — there's no client
    // path that creates an admin document, which prevents
    // self-promotion.
    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    // Tutor verification queue. Tutors write a pending doc when they
    // submit their profile for review; admins update the status when
    // they decide. Status transitions are gated to admins so a tutor
    // can't approve their own application.
    //
    // The `update` rule is intentionally permissive on `adminNotes` /
    // `reviewedBy` / `reviewedAt` because the admin often appends a
    // follow-up reason or corrects a prior decision. Status itself
    // is still gated to admins (no client-side toggle), and the
    // status change must be one of the four legal values.
    match /tutorVerifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.status == "pending";
      // Owner can update their own doc ONLY when transitioning from
      // "rejected" or "more_info" back to "pending" (resubmission).
      // This is secure because:
      //   - The owner cannot self-approve (can only set status to "pending")
      //   - The owner cannot update a doc that's "pending" or "approved"
      //   - The owner cannot change the status to anything other than "pending"
      // Admins can always update to any valid status.
      allow update: if (isOwner(uid)
                      && resource.data.status in ["rejected", "more_info"]
                      && request.resource.data.status == "pending")
                    || (isAdmin() && request.resource.data.status in
                      ["pending", "approved", "rejected", "more_info"]);
      allow delete: if isAdmin();
    }

    // Pending edit queue — when a verified tutor edits their profile
    // (full name, rate, location, etc.) the changes go here for admin
    // review instead of writing straight to `tutorProfile`. While a
    // doc is `pending`, the tutor's `hasPendingUpdate` flag is set
    // and student search/map queries filter the tutor out entirely.
    //
    // Why `allow update` also permits the owner when status is
    // "pending": a tutor who has previously submitted an edit and had
    // it reviewed (approved or rejected) may open the edit screen
    // again for a new submission. Their old `tutorProfileUpdates/{uid}`
    // doc still exists (with status "approved" or "rejected"), and
    // `batch.set(..., { merge: true })` on an existing doc is treated
    // as an `update` in the security rules. Without owner-update
    // permission for the "pending" status, the tutor gets
    // `permission-denied` on every re-submission.
    //
    // Security is preserved:
    //   - A tutor can only write their own doc with status "pending"
    //   - A tutor cannot change the status of an existing doc
    //     (create requires "pending", update with different status
    //     requires admin)
    //   - Admins can change status to approve/reject
    match /tutorProfileUpdates/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.status == "pending";
      allow update: if (isOwner(uid) && request.resource.data.status == "pending")
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications — one document per notification, addressed to a
    // user. The notification center reads them via `onSnapshot`.
    //
    // The actual notification docs live in the `items` SUBCOLLECTION
    // (`notifications/{uid}/items/{itemId}`) — see the nested match
    // below. The parent-doc match above it only covers the anchor doc
    // itself. Firestore rules do NOT cascade from a parent match to
    // its subcollections; without the nested block every notification
    // read/write fell through to the catch-all deny at the bottom
    // (the Aug 9 [firestore/permission-denied] storm).
    //
    // Writers:
    //   - Admins can `create` (e.g. when a verification decision is
    //     made, the admin's batch handler writes a doc here so the
    //     tutor sees it in their inbox).
    //   - Tutors can `create` enrollment_* notifications for their
    //     students (Phase 5 enrollment management). The alternative
    //     (every student subscribing to every tutor's
    //     enrollmentRequests subcollection) is N×M listeners. The
    //     trade-off is bounded: a malicious client can spam another
    //     user's inbox, but the `type` enum + `recipientUid == path`
    //     guards mean they cannot impersonate a different source of
    //     notifications or sneak a doc into someone else's folder.
    //     The admin can scrub via the Firebase Console.
    //   - The owning user can `update` only the `read` flag (a
    //     client-side tap on a notification). Everything else is
    //     server-only — no client can mutate the title / body /
    //     timestamp of a notification it didn't author.
    // NOTE: the app reads/writes the `items` SUBCOLLECTION, not this
    // parent doc. The parent block below exists for the anchor doc
    // itself (userLifecycle.ts deletes it on account purge); the
    // nested `items/{itemId}` block is the one that guards the real
    // notification rows.
    match /notifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.recipientUid == uid
        && isValidNotificationType(request.resource.data.type);
      allow update: if isOwner(uid) &&
        // The only mutable field on a notification is `read`.
        // The diff check below is the closest Firestore gets to
        // "this update only touched the read flag" — every other
        // field must round-trip to its current value.
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["read", "readAt"]);
      // Admin purges recipient notifications on account deletion.
      allow delete: if isAdmin();

      // The real notification docs — `notifications/{uid}/items/*`.
      // Mirrors the parent-doc intent one level down. Required for
      // NotificationBell / NotificationsCenter reads and the
      // writeNotification create (lib/verification/notifications.ts).
      match /items/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isSignedIn()
          && request.resource.data.recipientUid == uid
          && isValidNotificationType(request.resource.data.type);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["read", "readAt"]);
        // Admin purges a recipient's notification rows on account
        // deletion (lib/admin/userLifecycle.ts).
        allow delete: if isAdmin();
      }
    }

    // ────────────────────────────────────────────────────────────────────
    // Phase 5 — Tutor enrollment management
    // ────────────────────────────────────────────────────────────────────
    //
    // The four collections below power the tutor's "Capacity &
    // schedule" screen and the inbox / batch / dashboard flows.
    // They sit at the project root (not under `users/{uid}`) so a
    // student can read a tutor's batch + enrollment + availability
    // data via direct path navigation, and so the security rules
    // can enforce a count-based capacity invariant in O(1) by
    // reading the denormalized `enrolledCount` on the tutor's
    // profile subdoc.
    //
    // `enrollmentRequests/{tutorUid}/requests/{requestId}` — a
    // student's ask to study with a tutor. Hard-deleted on decline
    // (the row vanishes from the inbox permanently).
    //
    // The path is 3 levels deep because Firestore's `collection()` SDK
    // call requires an even-segment path (collection → doc → collection
    // → doc…). `enrollmentRequests` is a top-level collection,
    // `{tutorUid}` is the doc id, and `requests` is the named
    // subcollection that holds the auto-id'd request docs. A flat
    // top-level `enrollmentRequests/{requestId}` would have required
    // a composite index on `tutorUid`, which the plan avoided.
    match /enrollmentRequests/{tutorUid} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["_namespaceAnchor"]);
      allow update, delete: if false;
    }
    match /enrollmentRequests/{tutorUid}/requests/{requestId} {
      allow get, list: if isSignedIn();
      // Create: any signed-in user can write a request, but ONLY
      // with `studentUid == auth.uid` and `status == "pending"`.
      allow create: if isSignedIn()
        && request.resource.data.tutorUid == tutorUid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == "pending";
      // Update: the tutor (recipient) can flip status between
      // pending/accepted/declined. The student can only update
      // their own pending requests.
      allow update: if isSignedIn() && (
        resource.data.tutorUid == request.auth.uid
        || resource.data.studentUid == request.auth.uid
      );
      // Delete: tutors can drop rejected / pending requests to
      // clean their inbox. Students can drop their own pending
      // request.
      allow delete: if isSignedIn() && (
        resource.data.tutorUid == request.auth.uid
        || resource.data.studentUid == request.auth.uid
      );
    }

    // `reviews/{tutorUid}/reviews/{reviewId}` — student-written
    // reviews of a tutor. Reads are public; writes require a
    // signed-in student whose `studentUid == auth.uid` and
    // `status == "active"`.
    match /reviews/{tutorUid} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["_namespaceAnchor"]);
      allow update, delete: if false;
    }
    match /reviews/{tutorUid}/reviews/{reviewId} {
      allow get, list: if isSignedIn();
      // Aug 24 audit: score must be a bounded number (1-5) — an
      // unbounded score poisoned the client-computed aggregates the
      // reviewer carve-out then writes onto the profile.
      allow create: if isSignedIn()
        && request.resource.data.tutorUid == tutorUid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.score is number
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5;
      allow update: if isSignedIn()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["score", "comment", "updatedAt"])
        && request.resource.data.score is number
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5;
      allow delete: if isSignedIn()
        && (resource.data.studentUid == request.auth.uid || isAdmin());
    }

    // `enrollments/{tutorUid}/roster/{enrollmentId}` — the active
    // roster. Capacity is enforced by reading the denormalized
    // `enrolledCount` on the tutor's profile subdoc; the rule rejects
    // any create that would push the count above the cap.
    //
    // The subcollection is named `roster` (not `active`) so that
    // `collectionGroup(db, "roster")` does not collide with the
    // `classes` subcollection under `batches/{tutorUid}/`.
    match /enrollments/{tutorUid} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["_namespaceAnchor"]);
      allow update, delete: if false;
    }
    match /enrollments/{tutorUid}/roster/{enrollmentId} {
      allow get, list: if isSignedIn();
      // Create: enforced by the tutor's own transaction in
      // `FirebaseEnrollmentRepository.acceptRequest`. Gates on the
      // denormalized `enrolledCount` against the 6-student cap
      // (`max(profile.studentCapacity, 6)` so a tutor who left the
      // legacy default `studentCapacity = 0` still gets a safety net).
      //
      // Legacy profiles may predate the denormalized counters and
      // have NO `enrolledCount` / `studentCapacity` field at all — a
      // strict `int >= int` comparison would then evaluate against
      // `undefined` and hard-deny every create (the "acceptRequest
      // permission-denied" bug, Aug 2026). Coerce missing values to
      // 0 so the cap defaults to 6, mirroring the client-side
      // `num()` / `MAX_CAPACITY` defaults in
      // `FirebaseEnrollmentRepository.acceptRequest`.
      allow create: if isSignedIn()
        && request.resource.data.tutorUid == request.auth.uid
        && request.resource.data.tutorUid == tutorUid
        && request.resource.data.status == "active"
        && (
          'enrolledCount' in get(
            /databases/$(database)/documents/users/$(request.auth.uid)/tutorProfile/default
          ).data
            ? get(
              /databases/$(database)/documents/users/$(request.auth.uid)/tutorProfile/default
            ).data.enrolledCount
            : 0
        )
          < (
            // Pro subscription gate (Phase 2): FREE tutors are capped
            // at 5 active students (FREE_TIER_MAX_STUDENTS); Pro
            // tutors keep the existing `studentCapacity`/6 cap
            // (raised, not removed — the quality-protection intent of
            // the cap stays intact). Mirrors the client-side tier
            // check in `acceptRequest`, so the gate can't be bypassed
            // by a hand-rolled roster write.
            ('subscriptionTier' in get(
              /databases/$(database)/documents/users/$(request.auth.uid)/tutorProfile/default
            ).data
              && get(
                /databases/$(database)/documents/users/$(request.auth.uid)/tutorProfile/default
              ).data.subscriptionTier == "pro")
              ? (
                (
                  'studentCapacity' in get(
                    /databases/$(database)/documents/users/$(request.auth.uid)/tutorProfile/default
                  ).data
                    ? get(
                      /databases/$(database)/documents/users/$(request.auth.uid)/tutorProfile/default
                    ).data.studentCapacity
                    : 0
                ) >= 6
                  ? (
                    'studentCapacity' in get(
                      /databases/$(database)/documents/users/$(request.auth.uid)/tutorProfile/default
                    ).data
                      ? get(
                        /databases/$(database)/documents/users/$(request.auth.uid)/tutorProfile/default
                      ).data.studentCapacity
                      : 0
                  )
                  : 6
              )
              : 5
          );
      // Update: the tutor can flip status / removedAt / removeReason
      // (the three fields touched by `removeEnrollment`) and stamp
      // `batchId` (the denormalized batch pointer written by
      // `createBatch` when it seeds active enrollments as members —
      // the removal cascade reads it to reach the member doc via a
      // direct path instead of a rule-unprovable collectionGroup
      // scan). The tutor owns both the roster row and the batch, so
      // letting them point a row at one of their own classes is not
      // a privilege escalation.
      //
      // Student carve-out: the owning STUDENT may update ONLY
      // `endDate` / `updatedAt` on their own row. This exists for the
      // `__DEV__`-only QA fast-forward button on My Enrollments
      // (Enrollment.tsx `fastForwardToPast`) — it moves the row's
      // endDate to yesterday so `sweepExpiredEnrollments` flips the
      // card Active → Past without waiting for a real lapse. The
      // carve-out is intentionally narrow: no status / removedAt /
      // removeReason / batchId access, so a student can never
      // self-remove or point their row at a class. The row carries
      // `studentUid` (written by acceptRequest), which is what the
      // collectionGroup roster rule already keys on.
      allow update: if isSignedIn() && (
        // Tutor clause: the PATH owner (`request.auth.uid == tutorUid`)
        // may flip status / stamp removal fields. Using the path owner
        // instead of `resource.data.tutorUid == request.auth.uid` also
        // covers LEGACY roster rows created before `tutorUid` was a
        // required field — otherwise `sweepExpiredEnrollments` (which
        // runs on the tutor's own subscription) batch-commits a
        // permission-denied on those rows and the whole expiry sweep
        // fails, flooding the log. The path owner IS the tutor (create
        // is gated), so the security surface is unchanged.
        (request.auth.uid == tutorUid
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status", "removedAt", "removeReason", "batchId"]))
        || (resource.data.studentUid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["endDate", "updatedAt"]))
      );
      // Delete: the tutor can hard-delete (used by the cascade
      // handler in `removeEnrollment` when the existing
      // `status: "removed"` is not enough).
      allow delete: if isSignedIn() && resource.data.tutorUid == request.auth.uid;
    }

    // `batches/{tutorUid}/classes/{batchId}` — a tutor's group class.
    // `members/{memberId}` is a subcollection under the batch.
    match /batches/{tutorUid} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["_namespaceAnchor"]);
      allow update, delete: if false;
    }
    match /batches/{tutorUid}/classes/{batchId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.tutorUid == request.auth.uid
        && request.resource.data.tutorUid == tutorUid
        && request.resource.data.status == "active"
        && request.resource.data.slotKeys is list
        && request.resource.data.slotKeys.size() > 0;
      allow update: if isSignedIn()
        && resource.data.tutorUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.tutorUid == request.auth.uid;
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/batches/$(tutorUid)/classes/$(batchId)).data.tutorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/batches/$(tutorUid)/classes/$(batchId)).data.tutorUid == request.auth.uid;
      }
    }

    // ────────────────────────────────────────────────────────────────────
    // 1:1 messaging — conversations/{conversationId} + messages
    // ────────────────────────────────────────────────────────────────────
    //
    // Deterministic conversation ids (sorted participant pair joined
    // with `__` — see services/messages/types.ts), so either side
    // addresses the same doc without a query. Membership is checked
    // via two SCALAR fields (`participantA` / `participantB` = the
    // sorted pair) — scalar equality against `request.auth.uid` is the
    // battle-tested operator in this file, and list-membership ops
    // (`in` / `hasAny` / index access) fail the local rules emulator
    // with "Null value error" for doc-sourced lists (firebase-tools
    // 15.18 emulator quirk). The `participants` ARRAY still exists
    // for the SDK's `where participants array-contains uid` hub query.
    //
    // NOTE: bare `auth.uid` also hits that emulator null-value bug —
    // every check here uses `request.auth.uid`, matching the rest of
    // this rules file.
    match /conversations/{conversationId} {
      // `resource == null` matters: the chat screen subscribes to a
      // conversation doc that does NOT exist yet (before the first
      // message). Accessing `resource.data.X` on a missing doc THROWS
      // in rules, which surfaces as `permission-denied` instead of an
      // empty snapshot. Allow the (empty) read of a nonexistent doc;
      // existing docs still require participant membership.
      allow read: if isSignedIn()
        && (resource == null
            || resource.data.participantA == request.auth.uid
            || resource.data.participantB == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && (request.resource.data.participantA == request.auth.uid
            || request.resource.data.participantB == request.auth.uid);
      // Participants may bump lastMessage / their own meta entry;
      // non-participants can never touch the thread.
      allow update: if isSignedIn()
        && (resource.data.participantA == request.auth.uid
            || resource.data.participantB == request.auth.uid);
      allow delete: if false;

      match /messages/{messageId} {
        // Same missing-parent guard: the messages subcollection query
        // runs while the conversation doc may not exist yet.
        allow read: if isSignedIn() && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantA == request.auth.uid
          || get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantB == request.auth.uid
        );
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participantA == request.auth.uid
              || get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participantB == request.auth.uid);
        // Read receipts: a participant flips INCOMING messages from
        // "sent" to "read" when the chat opens (markMessagesRead).
        // Narrow — only status/readAt may change; text/senderId are
        // immutable after create. Either participant may flip any
        // message in the thread (both share the same chat), which is
        // how the double-checkmark works in practice.
        allow update: if isSignedIn()
          && (get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participantA == request.auth.uid
              || get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participantB == request.auth.uid)
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status", "readAt"]);
        allow delete: if false;
      }
    }

    // ────────────────────────────────────────────────────────────────────
    // Collection-group query access (student dashboard + repo lookups)
    // ────────────────────────────────────────────────────────────────────
    //
    // Firestore security rules do NOT authorize a `collectionGroup()`
    // query via path-specific match blocks. A path-specific rule such
    // as `match /enrollments/{tutorUid}/roster/{enrollmentId}` only
    // guards DIRECT-path reads (collection(db, "enrollments", uid,
    // "roster")) — a `collectionGroup(db, "roster")` query over every
    // tutor's roster fails with permission-denied even when the
    // path-specific rule allows it (the Aug 11 log showed exactly
    // this for subscribeEnrollmentsByStudent / subscribeRequestsByStudent).
    //
    // A collectionGroup query requires a match with a RECURSIVE parent
    // wildcard: `match /{path=**}/roster/{doc}`. Each block below
    // binds that wildcard as `{prefix=**}` — the literal collection
    // name in the match declaration (e.g. `/roster/{enrollmentId}`)
    // scopes the rule to that exact collection ID wherever it appears
    // in the document tree.
    //
    // IMPORTANT: `{prefix=**}` captures the ENTIRE matched path as a
    // single string (per the rules-behavior docs:
    // https://firebase.google.com/docs/rules/rules-behavior), so
    // `prefix[0]` returns the first CHARACTER, not the first SEGMENT.
    // Earlier code used `prefix.size() >= 2 && prefix[0] == "enrollments"`
    // which always evaluated false (prefix[0] was `"e"`, not
    // `"enrollments"`), short-circuiting the `&&` chain before
    // `resource.data.studentUid == auth.uid` was ever checked. The
    // fix: rely on resource-data identity instead. Every write path
    // populates `studentUid` and/or `tutorUid` on each row (verified
    // in FirebaseEnrollmentRepository.ts:620 / :768), so checking
    // those fields is sufficient. Read-only — all writes stay on the
    // direct-path rules above.
    // IMPORTANT — real Firestore applies a recursive rule's
    // conditions to DIRECT-PATH list queries too (not just
    // collectionGroup ones): a query on `enrollments/{tutorUid}/roster`
    // matches BOTH the path-specific rule below AND this recursive
    // rule, and the strictest wins. The TutorDetailsScreen (student
    // facing) lists a tutor's roster / classes / requests by direct
    // path to build the BookedMap, the pending-hourglass overlay, and
    // the batch list — so these recursive rules MUST allow signed-in
    // reads exactly like the path-specific rules do. That the direct
    // path is already readable by any signed-in user means the
    // collectionGroup surface exposes the same data, so there is no
    // new privacy surface here. (The emulator does NOT reproduce this
    // AND-ing — it accepts the path-specific allow alone — which is
    // why the live smoke test, not the emulator, catches regressions.)
    match /{prefix=**}/roster/{enrollmentId} {
      allow get, list: if isSignedIn();
    }
    match /{prefix=**}/requests/{requestId} {
      allow get, list: if isSignedIn();
    }
    match /{prefix=**}/members/{memberId} {
      allow get, list: if isSignedIn();
    }
    match /{prefix=**}/classes/{batchId} {
      // The marketplace "Browse open batches" screen lists every
      // ACTIVE batch via a collectionGroup query. Any signed-in user
      // may list classes — active ones by design, ended ones because
      // the tutor-details BookedMap reads them via direct path and
      // the recursive rule must not be stricter than the direct-path
      // rule (see the note above). The UI filters by status.
      allow get, list: if isSignedIn();
    }
    match /{prefix=**}/reviews/{reviewId} {
      // The marketplace overlays live per-tutor rating/reviewCount from
      // a single `collectionGroup("reviews")` subscription (see
      // services/tutors/FirebaseTutorRepository.ts). The direct-path
      // rule above already allows any signed-in user to read a tutor's
      // reviews; this recursive rule is what a collectionGroup query
      // actually evaluates against, so it MUST match that allowance.
      // Restricting to `studentUid == auth.uid || isAdmin()` here is
      // what surfaced as "TutorRepository: reviews aggregate subscribe
      // failed [permission-denied]" on every marketplace render — a
      // student browsing tutor cards is neither the review author nor
      // an admin. Reviews are public-facing content (name, score,
      // comment), so signed-in reads are safe.
      allow get, list: if isSignedIn();
    }

    // Everything else stays locked down. The app's MVP only touches
    // /users/{uid} and its subcollections; new collections need an
    // explicit rule added here before the client can read/write.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
