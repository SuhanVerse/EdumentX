{
  "expo": {
    "name": "EdumentX",
    "slug": "edumentx",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "edumentx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.edumentx"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d8524c04-2df7-4446-93fc-8a0bad7a6e54"
      }
    }
  }
}
